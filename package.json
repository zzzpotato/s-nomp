{
    "name": "s-nomp",
    "version": "0.0.9",
    "description": "zero-proof (Equihash) node stratum mining pool based on NOMP",
    "keywords": [
        "stratum",
        "mining",
        "pool",
        "server",
        "poolserver",
        "equihash"
    ],
    "homepage": "https://github.com/s-nomp/s-nomp",
    "bugs": {
        "url": "https://github.com/s-nomp/s-nomp/issues"
    },
    "license": "MIT",
    "author": "s-nomp dev team",
    "contributors": [
        "aayanl",
        "egyptianbman",
        "Matthew Little",
        "sennevb",
        "TheSeven",
        "vekexasia"
    ],
    "main": "init.js",
    "type": "module",
    "bin": {
        "block-notify": "./scripts/blockNotify.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/s-nomp/s-nomp.git"
    },
    "dependencies": {
        "async": "^3.2.5",
        "bignum": "^0.13.0",
        "body-parser": "^1.20.2",
        "colors": "^1.4.0",
        "compression": "^1.7.4",
        "dateformat": "^5.0.3",
        "dot": "^2.0.0",
        "express": "^4.18.2",
        "extend": "^3.0.2",
        "mysql2": "^3.6.5",
        "node-json-minify": "^3.0.0",
        "node-watch": "^0.7.4",
        "nonce": "^1.0.4",
        "redis": "^4.6.10",
        "undici": "^5.28.2",
        "stratum-pool": "git+https://github.com/s-nomp/node-stratum-pool.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "start": "LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$PWD/node_modules/stratum-pool/node_modules/equihashverify/build/Release/:$PWD/node_modules/equihashverify/build/Release/ node --experimental-modules init.js",
        "dev": "node --experimental-modules --inspect init.js",
        "test": "node --test"
    }
}
